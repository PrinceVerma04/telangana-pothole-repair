# 1 = always use the in-browser mock API (seeded Hyderabad data); 0 = always use the real API.
# Unset = probe ${VITE_API_BASE}/v1/healthz at startup and fall back to the mock when unreachable.
VITE_USE_MOCK=
# Base URL of the RoadFix API ('' = same origin; vite dev proxies /v1 to API_PROXY_TARGET).
VITE_API_BASE=
API_PROXY_TARGET=http://localhost:8000
