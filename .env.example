# Copy to .env. Every value has a working demo default; nothing here is required for `make measure-demo`.

# --- runtime mode -------------------------------------------------------------
DEMO_MODE=1            # 1 = pipeline runs inline on ingest (no worker process)
DEMO_LITE=1            # 1 = SQLite + filesystem storage, no Redis/MinIO/PostGIS (DECISIONS D1-D3)

# --- database (D1) ------------------------------------------------------------
DATABASE_URL=sqlite:///data/gunthameter.db
# production: postgresql+psycopg://gm:gm@localhost:5433/gunthameter   (PostGIS required)

# --- storage (D3) -------------------------------------------------------------
STORAGE_BACKEND=fs     # fs | s3
STORAGE_ROOT=data/store
S3_ENDPOINT=
S3_BUCKET=gunthameter
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- queue (D2) ---------------------------------------------------------------
REDIS_URL=             # empty = in-process pipeline

# --- models -------------------------------------------------------------------
SEG_WEIGHTS=weights/bootstrap_pothole_yolo26m.pt     # D9: replaced by runs/.../best.pt after training
VERIFIER_WEIGHTS=weights/bootstrap_pothole_yolov8s.pt # D5; VERIFIER=off disables
VERIFIER=on
DEPTH_BACKEND=off                                     # D27 size-only, no depth model | da2_metric | da3_metric | metric3d_onnx | synthetic
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Metric-Outdoor-Base-hf
CUDA_DEVICE=0

# --- auth ---------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_TTL_MIN=720
OTP_DEMO_CODE=123456   # demo only: fixed OTP, never in production

# --- external -----------------------------------------------------------------
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
ROBOFLOW_API_KEY=
OSRM_URL=
IMD_RAIN_FEED_URL=     # empty = manual monsoon/rain flag in admin

# --- web ----------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
