{
  "name": "gunthameter-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GunthaMeter PWA - pothole measurement, prioritisation and repair operations (Telugu-first)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "dexie": "4.4.7",
    "i18next": "27.1.1",
    "maplibre-gl": "6.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "7.18.5",
    "recharts": "3.10.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "puppeteer-core": "25.17.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
