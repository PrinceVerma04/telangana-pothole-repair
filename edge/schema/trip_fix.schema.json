{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gunthameter.local/schema/trip_fix.schema.json",
  "title": "GunthaMeter 1 Hz trip telemetry batch",
  "description": "POST /v1/ingest/trip-fixes. cam_active=true + no detection proves a clean pass (verification, archive of candidates, passes_total).",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "trip_id", "fixes"],
  "properties": {
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "trip_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "gtfs_route_id": { "type": ["string", "null"] },
    "fixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts", "lat", "lon", "cam_active"],
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "lat": { "type": "number", "minimum": 6.0, "maximum": 38.0 },
          "lon": { "type": "number", "minimum": 68.0, "maximum": 98.0 },
          "accuracy_m": { "type": "number", "minimum": 0, "maximum": 500 },
          "speed_mps": { "type": "number", "minimum": 0, "maximum": 60 },
          "heading_deg": { "type": "number", "minimum": 0, "maximum": 360 },
          "az_rms": { "type": "number", "minimum": 0 },
          "cam_active": { "type": "boolean" }
        }
      }
    }
  }
}
